	Label.BackgroundTransparency = 1
	Label.Text = name
	Label.Font = Enum.Font.Gotham
	Label.TextSize = 12
	Label.TextColor3 = Color3.fromRGB(180, 180, 200)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Container
	
	local Btn = Instance.new("TextButton")
	Btn.Size = UDim2.new(0, 40, 0, 20)
	Btn.Position = UDim2.new(1, -42, 0.5, -10)
	Btn.BackgroundColor3 = Settings[settingKey] and Color3.fromRGB(40, 160, 80) or Color3.fromRGB(60, 60, 70)
	Btn.Text = Settings[settingKey] and "ON" or "OFF"
	Btn.Font = Enum.Font.GothamBold
	Btn.TextSize = 10
	Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	Btn.AutoButtonColor = false
	Btn.Parent = Container
	
	local BtnCorner = Instance.new("UICorner")
	BtnCorner.CornerRadius = UDim.new(0, 4)
	BtnCorner.Parent = Btn
	
	Btn.MouseButton1Click:Connect(function()
		Settings[settingKey] = not Settings[settingKey]
		Btn.BackgroundColor3 = Settings[settingKey] and Color3.fromRGB(40, 160, 80) or Color3.fromRGB(60, 60, 70)
		Btn.Text = Settings[settingKey] and "ON" or "OFF"
		SaveSettings()
	end)
end

local function CreateSlider(name, settingKey, min, max, order)
	local Container = Instance.new("Frame")
	Container.Size = UDim2.new(1, -4, 0, 44)
	Container.BackgroundTransparency = 1
	Container.LayoutOrder = order
	Container.Parent = ScrollFrame
	
	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, -40, 0, 16)
	Label.BackgroundTransparency = 1
	Label.Text = name .. ": " .. tostring(math.floor(Settings[settingKey] * 100) / 100)
	Label.Font = Enum.Font.Gotham
	Label.TextSize = 11
	Label.TextColor3 = Color3.fromRGB(180, 180, 200)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Container
	
	local ValLabel = Instance.new("TextLabel")
	ValLabel.Size = UDim2.new(0, 36, 0, 16)
	ValLabel.Position = UDim2.new(1, -38, 0, 0)
	ValLabel.BackgroundTransparency = 1
	ValLabel.Text = tostring(math.floor(Settings[settingKey] * 100) / 100)
	ValLabel.Font = Enum.Font.GothamBold
	ValLabel.TextSize = 11
	ValLabel.TextColor3 = Color3.fromRGB(140, 180, 255)
	ValLabel.TextXAlignment = Enum.TextXAlignment.Right
	ValLabel.Parent = Container
	
	local SliderBg = Instance.new("Frame")
	SliderBg.Size = UDim2.new(1, 0, 0, 6)
	SliderBg.Position = UDim2.new(0, 0, 0, 22)
	SliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	SliderBg.Parent = Container
	
	local SlCorner = Instance.new("UICorner")
	SlCorner.CornerRadius = UDim.new(1, 0)
	SlCorner.Parent = SliderBg
	
	local Fill = Instance.new("Frame")
	Fill.Size = UDim2.new((Settings[settingKey] - min) / (max - min), 0, 1, 0)
	Fill.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
	Fill.Parent = SliderBg
	
	local FCorner = Instance.new("UICorner")
	FCorner.CornerRadius = UDim.new(1, 0)
	FCorner.Parent = Fill
	
	local Hitbox = Instance.new("TextButton")
	Hitbox.Size = UDim2.new(1, 0, 0, 20)
	Hitbox.Position = UDim2.new(0, 0, 0, 16)
	Hitbox.BackgroundTransparency = 1
	Hitbox.Text = ""
	Hitbox.Parent = Container
	
	local function UpdateSlider(input)
		local rel = math.clamp((input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
		local val = min + (max - min) * rel
		val = math.floor(val * 1000) / 1000
		Settings[settingKey] = val
		Fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
		Label.Text = name .. ": " .. tostring(math.floor(val * 100) / 100)
		ValLabel.Text = tostring(math.floor(val * 100) / 100)
		SaveSettings()
	end
	
	local sliderDragging = false
	
	Hitbox.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliderDragging = true
			UpdateSlider(input)
		end
	end)
	
	Hitbox.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliderDragging = false
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			UpdateSlider(input)
		end
	end)
end

