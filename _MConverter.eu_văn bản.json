local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local AnimationWhitelist = {
	["100962226150441"] = true,
	["74145636023952"] = true,
	["123171106092050"] = true,
	["95852624447551"] = true
}

local Settings = {
	autoBFChain = true,
	bfChainMode = "legit",
	offsetStuds = 5,
	tweenTime = 0.17,
	lookTime = 0.32,
	autoFireFist = true,
	divergentFistDelay = 0.29,
	autoAim = true,
	aimMode = "Camera",
	cameraSlowness = 0,
	autoJump = false,
	jumpDuration = 0.01,
	jumpPower = 45,
	legitInfrontCheck = 11,
	legitSpeed = 0.085,
	legitArcWidth = 4.3,
	legitSlowdownInterval = 0.015,
	legitSlowdownAmount = 0.007,
	legitBehindCheck = true,
	legitBehindCheckDist = 12,
	legitSideCheck = true,
	feintEnabled = true,
	feintDelay = 0.27,
	maxDistance = 50 -- new: 1-100 studs limit
}

local SettingsFile = "bfchainSettings.json"

local function SaveSettings()
	if writefile then
		pcall(function()
			writefile(SettingsFile, HttpService:JSONEncode(Settings))
		end)
	end
end

local function LoadSettings()
	if isfile and readfile and isfile(SettingsFile) then
		local success, loaded = pcall(function()
			return HttpService:JSONDecode(readfile(SettingsFile))
		end)
		if success and type(loaded) == "table" then
			for key, value in pairs(loaded) do
				if Settings[key] ~= nil then
					Settings[key] = value
				end
			end
		end
	end
end

LoadSettings()

-- clamp max distance on load
Settings.maxDistance = math.clamp(Settings.maxDistance or 50, 1, 100)

local PlayerCharacter, PlayerHumanoid, PlayerRoot, PlayerAnimator
local AnimationConnection
local AttackCount = 0
local CameraTarget = nil
local CameraRotation = nil

RunService:BindToRenderStep("ShiftlockAimFix", Enum.RenderPriority.Camera.Value + 1, function()
	if not CameraTarget then
		CameraRotation = nil
		return
	end
	
	local CamPos = Camera.CFrame.Position
	local TargetCFrame = CFrame.new(CamPos, CameraTarget)
	
	if Settings.cameraSlowness <= 0 then
		Camera.CFrame = TargetCFrame
		CameraRotation = TargetCFrame.Rotation
	else
		local CurrentCFrame = (CameraRotation and (CFrame.new(CamPos) * CameraRotation)) or Camera.CFrame
		local Smoothness = 1 / ((Settings.cameraSlowness * 3) + 1)
		local LerpedCFrame = CurrentCFrame:Lerp(TargetCFrame, math.clamp(Smoothness, 0, 1))
		Camera.CFrame = LerpedCFrame
		CameraRotation = LerpedCFrame.Rotation
	end
end)

local function ResetCamera()
	if CameraTarget then
		local Target = CameraTarget
		CameraTarget = nil
		CameraRotation = nil
		local NewCFrame = CFrame.new(Camera.CFrame.Position, Target)
		Camera.CameraType = Enum.CameraType.Scriptable
		Camera.CFrame = NewCFrame
		task.defer(function()
			Camera.CameraType = Enum.CameraType.Custom
		end)
	end
end

local function ExtractAnimationId(animation)
	if not animation then return "" end
	return tostring(animation):match("%d+") or tostring(animation)
end

local function FindNearestEnemy()
	if not PlayerCharacter or not PlayerRoot then return nil end
	
	local NearestEnemy = nil
	local NearestDistance = math.huge
	local PlayerPos = PlayerRoot.Position
	
	for _, model in ipairs(workspace:GetDescendants()) do
		if model:IsA("Model") and model ~= PlayerCharacter then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local rootPart = model:FindFirstChild("HumanoidRootPart")
			
			if humanoid and rootPart and humanoid.Health > 0 then
				local distance = (rootPart.Position - PlayerPos).Magnitude
				if distance < NearestDistance and distance <= Settings.maxDistance then
					NearestDistance = distance
					NearestEnemy = rootPart
				end
			end
		end
	end
	
	return NearestEnemy
end

local function SetupCharacter(character)
	PlayerCharacter = character
	PlayerHumanoid = character:WaitForChild("Humanoid")
	PlayerRoot = character:WaitForChild("HumanoidRootPart")
	PlayerAnimator = PlayerHumanoid:WaitForChild("Animator")
	
	if AnimationConnection then
		AnimationConnection:Disconnect()
		AnimationConnection = nil
	end
	
	AnimationConnection = PlayerAnimator.AnimationPlayed:Connect(function(animTrack)
		local AnimId = ExtractAnimationId(animTrack.Animation and animTrack.Animation.AnimationId)
		
		if not AnimationWhitelist[AnimId] then return end
		
		AttackCount += 1
		local CurrentAttackCount = AttackCount
		
		if Settings.feintEnabled then
			task.spawn(function()
				task.wait(Settings.feintDelay)
				if PlayerCharacter and PlayerRoot then
					local Enemy = FindNearestEnemy()
					if Enemy then
						local DirToEnemy = PlayerRoot.Position - Enemy.Position
						local EnemyLook = Enemy.CFrame.LookVector
						
						if EnemyLook:Dot(DirToEnemy.Unit) >= 0 then
							pcall(function()
								game:GetService("ReplicatedStorage"):WaitForChild("Knit"):WaitForChild("Knit"):WaitForChild("Services"):WaitForChild("ItadoriService"):WaitForChild("RE"):WaitForChild("RightActivated"):FireServer()
							end)
						end
					end
				end
			end)
		end
		
		if Settings.autoJump and PlayerRoot then
			task.spawn(function()
				local EndTime = os.clock() + Settings.jumpDuration
				while os.clock() < EndTime and Settings.autoJump and PlayerRoot and PlayerRoot.Parent do
					pcall(function()
						PlayerRoot.AssemblyLinearVelocity = Vector3.new(
							PlayerRoot.AssemblyLinearVelocity.X,
							Settings.jumpPower,
							PlayerRoot.AssemblyLinearVelocity.Z
						)
					end)
					RunService.Heartbeat:Wait()
				end
			end)
		end
		
		if Settings.autoFireFist then
			task.spawn(function()
				task.wait(Settings.divergentFistDelay)
				pcall(function()
					local Moveset = LocalPlayer.Character:FindFirstChild("Moveset")
					if Moveset then
						local DivergentFist = Moveset:FindFirstChild("Divergent Fist")
						if DivergentFist then
							local Args = {DivergentFist}
							ReplicatedStorage:WaitForChild("Knit"):WaitForChild("Knit"):WaitForChild("Services"):WaitForChild("DivergentFistService"):WaitForChild("RE"):WaitForChild("Activated"):FireServer(unpack(Args))
						end
					end
				end)
			end)
		end
		
		if Settings.autoBFChain or Settings.autoAim then
			task.spawn(function()
				local StartTime = os.clock()
				local PlayerPos = PlayerRoot.Position
				local ChainMode = "normal"
				local Enemy = FindNearestEnemy()
				
				if Settings.autoBFChain and Settings.bfChainMode == "legit" and Settings.legitSideCheck and Enemy then
					local DirToEnemy = PlayerPos - Enemy.Position
					local EnemyLook = Enemy.CFrame.LookVector
					if math.abs(EnemyLook:Dot(DirToEnemy.Unit)) < 0.8 then
						local RelativeLook = PlayerRoot.CFrame:VectorToObjectSpace(Enemy.CFrame.LookVector)
						if RelativeLook.X > 0 then
							ChainMode = "270_right"
						else
							ChainMode = "270_left"
						end
					end
				end
				
				if ChainMode == "normal" and Settings.autoBFChain and Settings.bfChainMode == "legit" and Settings.legitBehindCheck and Enemy then
					local DirToEnemy = PlayerPos - Enemy.Position
					local EnemyLook = Enemy.CFrame.LookVector
					if DirToEnemy.Magnitude <= Settings.legitBehindCheckDist and EnemyLook:Dot(DirToEnemy.Unit) < 0 then
						if math.random(1, 2) == 1 then
							local RelativePos = Enemy.CFrame:PointToObjectSpace(PlayerPos)
							if RelativePos.X < 0 then
								ChainMode = "360_left"
							else
								ChainMode = "360_right"
							end
						else
							ChainMode = "nothing"
						end
					end
				end
				
				if ChainMode == "nothing" then
					ResetCamera()
					return
				end
				
				local Slowdown = 0
				local IsSlowing = false
				local SlowdownTime = 0
				local LastProgress = 0
				
				while true do
					local Duration = (Settings.bfChainMode == "legit" and Settings.autoBFChain and (Settings.legitSpeed + Slowdown)) or Settings.tweenTime
					local TotalDuration = Duration + Settings.lookTime
					local Elapsed = os.clock() - StartTime
					
					if Elapsed >= TotalDuration then break end
					if CurrentAttackCount ~= AttackCount or not PlayerCharacter.Parent or not PlayerRoot.Parent then
						ResetCamera()
						return
					end
					
					local CurrentEnemy = FindNearestEnemy()
					if CurrentEnemy then
						local EnemyPos = CurrentEnemy.Position
						local ShouldChain = Settings.autoBFChain
						local TargetPos = EnemyPos
						
						if ShouldChain and Settings.bfChainMode == "legit" and not string.find(ChainMode, "360") and not string.find(ChainMode, "270") then
							local DirToEnemy = EnemyPos - PlayerPos
							local Distance = DirToEnemy.Magnitude
							if Distance > 0.1 then
								local DotProduct = PlayerRoot.CFrame.LookVector:Dot(DirToEnemy.Unit)
								if Distance > Settings.legitInfrontCheck or DotProduct < 0.4 then
									ShouldChain = false
								end
							else
								ShouldChain = false
							end
						end
						
						if ShouldChain and Settings.bfChainMode == "legit" then
							if string.find(ChainMode, "360") or string.find(ChainMode, "270") then
								TargetPos = EnemyPos
							else
								local ArcWidth = Settings.legitArcWidth
								local DirToEnemy = PlayerPos - EnemyPos
								local Angle = math.atan2(DirToEnemy.Z, DirToEnemy.X)
								local PerpAngle = Angle + (math.pi * 0.5)
								TargetPos = Vector3.new(
									EnemyPos.X + (math.cos(PerpAngle) * ArcWidth),
									PlayerPos.Y,
									EnemyPos.Z + (math.sin(PerpAngle) * ArcWidth)
								)
							end
						end
						
						if ShouldChain then
							if Elapsed < Duration then
								local Progress = math.clamp(Elapsed / Duration, 0, 1)
								local AimPos
								local PlayerY = nil
								
								if Settings.autoJump then
									PlayerY = PlayerRoot.Position.Y
								end
								
								if Settings.bfChainMode == "semi legit" then
									local OffsetTarget = EnemyPos - (CurrentEnemy.CFrame.LookVector * Settings.offsetStuds)
									local MaxOffset = math.max(Settings.offsetStuds, 2)
									local DirToPlayer = PlayerPos - EnemyPos
									local DirToOffset = OffsetTarget - EnemyPos
									local BaseAngle = math.atan2(DirToPlayer.Z, DirToPlayer.X)
									local OffsetAngle = math.atan2(DirToOffset.Z, DirToOffset.X)
									local AngleDiff = OffsetAngle - BaseAngle
									
									if AngleDiff > math.pi then
										AngleDiff -= (2 * math.pi)
									elseif AngleDiff < -math.pi then
										AngleDiff += (2 * math.pi)
									end
									
									local InterpolatedAngle = BaseAngle + (AngleDiff * Progress)
									if not PlayerY then
										PlayerY = PlayerPos.Y + ((OffsetTarget.Y - PlayerPos.Y) * Progress)
									end
									
									AimPos = Vector3.new(
										EnemyPos.X + (math.cos(InterpolatedAngle) * MaxOffset),
										PlayerY,
										EnemyPos.Z + (math.sin(InterpolatedAngle) * MaxOffset)
									)
								
								elseif Settings.bfChainMode == "legit" then
									local IsRotation = string.find(ChainMode, "360") or string.find(ChainMode, "270")
									local RotationThreshold = (IsRotation and 0.25) or 0.5
									
									if not IsSlowing and Progress >= RotationThreshold then
										IsSlowing = true
										SlowdownTime = Elapsed
									end
									
									if IsSlowing then
										local SlowElapsed = Elapsed - SlowdownTime
										if SlowElapsed >= Settings.legitSlowdownInterval and Settings.legitSlowdownInterval > 0 then
											local SlowSteps = math.floor(SlowElapsed / Settings.legitSlowdownInterval)
											Slowdown = Slowdown + (SlowSteps * Settings.legitSlowdownAmount)
											SlowdownTime = SlowdownTime + (SlowSteps * Settings.legitSlowdownInterval)
											Duration = Settings.legitSpeed + Slowdown
											Progress = math.clamp(Elapsed / Duration, 0, 1)
										end
										
										if Progress >= 1 then
											break
										elseif Progress <= LastProgress then
											break
										end
									end
									
									LastProgress = Progress
									
									local ArcWidth = Settings.legitArcWidth
									local DirToEnemy = PlayerPos - EnemyPos
									local BaseAngle = math.atan2(DirToEnemy.Z, DirToEnemy.X)
									local RotationAmount = math.pi
									
									if ChainMode == "360_left" then
										RotationAmount = math.pi * 2
									elseif ChainMode == "360_right" then
										RotationAmount = -math.pi * 2
									elseif ChainMode == "270_left" then
										RotationAmount = math.pi * 1.5
									elseif ChainMode == "270_right" then
										RotationAmount = -math.pi * 1.5
									end
									
									local InterpolatedAngle = BaseAngle + (RotationAmount * Progress)
									if not PlayerY then
										PlayerY = PlayerPos.Y
									end
									
									AimPos = Vector3.new(
										EnemyPos.X + (math.cos(InterpolatedAngle) * ArcWidth),
										PlayerY,
										EnemyPos.Z + (math.sin(InterpolatedAngle) * ArcWidth)
									)
								end
								
								if Settings.autoAim and not string.find(ChainMode, "360") then
									if Settings.aimMode == "Character" then
										PlayerRoot.CFrame = CFrame.new(AimPos, TargetPos)
										ResetCamera()
									elseif Settings.aimMode == "Camera" then
										PlayerRoot.CFrame = CFrame.new(AimPos) * PlayerRoot.CFrame.Rotation
										CameraTarget = TargetPos
									end
								else
									PlayerRoot.CFrame = CFrame.new(AimPos) * PlayerRoot.CFrame.Rotation
									ResetCamera()
								end
							
							elseif Settings.autoAim and not string.find(ChainMode, "360") then
								if Settings.aimMode == "Character" then
									PlayerRoot.CFrame = CFrame.new(PlayerRoot.Position, TargetPos)
									ResetCamera()
								elseif Settings.aimMode == "Camera" then
									CameraTarget = TargetPos
								end
							else
								ResetCamera()
							end
						
						elseif Settings.autoAim and not string.find(ChainMode, "360") then
							if Settings.aimMode == "Character" then
								PlayerRoot.CFrame = CFrame.new(PlayerRoot.Position, TargetPos)
								ResetCamera()
							elseif Settings.aimMode == "Camera" then
								CameraTarget = TargetPos
							end
						else
							ResetCamera()
						end
					else
						ResetCamera()
					end
					
					RunService.RenderStepped:Wait()
				end
				
				ResetCamera()
			end)
		end
	end)
end

LocalPlayer.CharacterAdded:Connect(SetupCharacter)
if LocalPlayer.Character then
	SetupCharacter(LocalPlayer.Character)
end

